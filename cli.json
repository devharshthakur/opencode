{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "light"
  },

  "diffs": {
    "wrap": "none",
    "tree": false,
    "view": "unified",
    "single": true
  },

  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": true,
    "tps": true,
    "permissions": "autoaccept",
    "verbosity": "low"
  },
  "prompt": {
    "paste": "compact",
    "editor": true,
    "image_preview": true
  },
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.5
  },
  "animations": true,
  "scroll": {
    "speed": 3,
    "acceleration": true
  },
  "debug": {
    "devtools": false
  },
  "terminal": {
    "copy": "manual"
  },
  "leader": {
    "timeout": 2750
  }
}
