// Copy to opencode.jsonc and select accounts/models you can access.
// The ignored local file may retain inline secrets by explicit user choice.
// This tracked sample always uses environment references.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "dev",
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": { "settings": { "reasoningEffort": "low" } }
      }
    }
  },
  "agents": {
    "plan": { "disabled": true },
    "build": { "disabled": true },
    "general": { "disabled": true },
    "dev": { "model": "opencode-go/deepseek-v4.1-flash#low" },
    "chat": { "model": "opencode-go/deepseek-v4.1-flash#high" },
    "explore": { "model": "opencode-go/muse-spark-1.3-contributor#medium" },
    "implement": { "model": "opencode-go/deepseek-v4.1-flash#high" }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*.key", "effect": "ask" },
    { "action": "read", "resource": "*.p12", "effect": "ask" },
    { "action": "read", "resource": "*.pfx", "effect": "ask" },
    { "action": "read", "resource": "*.ppk", "effect": "ask" },
    { "action": "read", "resource": "*.ssh/*", "effect": "ask" },
    { "action": "read", "resource": "*id_rsa", "effect": "ask" },
    { "action": "read", "resource": "*id_ed25519", "effect": "ask" },
    { "action": "read", "resource": "*id_ecdsa", "effect": "ask" },
    { "action": "read", "resource": "*.netrc", "effect": "ask" },
    { "action": "read", "resource": "*.npmrc", "effect": "ask" },
    { "action": "read", "resource": "*.pypirc", "effect": "ask" },
    { "action": "read", "resource": "*.aws/credentials*", "effect": "ask" }
  ],
  "compaction": { "auto": false, "keep": { "tokens": 30000 } },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
        "timeout": { "catalog": 120000, "execution": 120000 },
        "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
      },
      "aws-mcp": {
        "type": "local",
        "command": ["uvx", "mcp-proxy-for-aws@latest", "https://aws-mcp.us-east-1.api.aws/mcp", "--metadata", "AWS_REGION=us-west-2"],
        "disabled": true,
        "timeout": { "catalog": 100000, "execution": 100000 }
      },
      "github": {
        "type": "remote", "url": "https://api.githubcopilot.com/mcp/",
        "disabled": true, "oauth": false,
        "headers": { "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}" }
      },
      "gcloud": { "type": "local", "command": ["npx", "-y", "@google-cloud/gcloud-mcp"], "disabled": true },
      "gcloud-backupdr": { "type": "local", "command": ["npx", "-y", "@google-cloud/backupdr-mcp"], "disabled": true },
      "gcloud-observability": { "type": "local", "command": ["npx", "-y", "@google-cloud/observability-mcp"], "disabled": true },
      "gcloud-storage": { "type": "local", "command": ["npx", "-y", "@google-cloud/storage-mcp"], "disabled": true },
      "homebrew": { "type": "local", "command": ["brew", "mcp-server"], "disabled": true },
      "vercel": { "type": "remote", "url": "https://mcp.vercel.com", "disabled": true },
      "canva": {
        "type": "local", "command": ["npx", "-y", "mcp-remote@latest", "https://mcp.canva.com/mcp"],
        "disabled": true, "timeout": { "catalog": 60000, "execution": 60000 }
      },
      "notion": { "type": "remote", "url": "https://mcp.notion.com/mcp", "disabled": true },
      "chrome-devtools": { "type": "local", "command": ["npx", "-y", "chrome-devtools-mcp@latest"], "disabled": true },
      "cloudflare-api": { "type": "remote", "url": "https://mcp.cloudflare.com/mcp", "disabled": true },
      "linkedin": { "type": "local", "command": ["uvx", "mcp-server-linkedin@latest"], "disabled": true, "environment": { "UV_HTTP_TIMEOUT": "300" } },
      "kite": { "type": "remote", "url": "https://mcp.kite.trade/mcp", "disabled": true }
    }
  },
  "shell": "zsh"
}
